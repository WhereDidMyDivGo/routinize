{
  "schemaVersion": 1,
  "id": "routinize",
  "version": "${version}",
  "name": "Routinize",
  "description": "Automates gameplay with a live-editable step sequence: scan GUI contents by item name and lore, run commands, and hold real keys and mouse buttons.",
  "authors": ["WhoSaysImGay"],
  "license": "MIT",
  "icon": "assets/routinize/icon.png",
  "environment": "client",

  "entrypoints": {
    "client": ["com.github.wheredidmydivgo.routinize.RoutinizeClient"]
  },

  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  },

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github": "https://github.com/WhereDidMyDivGo/routinize",
        "routinize.github_releases": "https://github.com/WhereDidMyDivGo/routinize/releases",
        "modmenu.modrinth": "https://modrinth.com/mod/routinize"
      }
    }
  }
}
